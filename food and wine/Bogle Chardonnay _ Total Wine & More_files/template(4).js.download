  .content-slider-modal-container {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    z-index: 30;
  }

  .content-slider-content {
    position: absolute;
    height: 100%;
    width: 100%;
    padding: 0;
    margin: 0 auto;
    max-height: initial;
    max-width: initial;
    @media screen and (max-width: 640px) {
      top: 0;
      .content-slide-thumbnails {
        .splide__slide {
          width: `,`;
          height: `,`;
        }
      }
    }
    @media screen and (max-width: 1024px) {
      width: 100%;
      & > div:nth-child(2) {
        height: fit-content;
        left: 0px;
        top: 0px;
      }
    }
    @media screen and (min-width: 1025px) {
      position: fixed;
      width: 100%;
    }
  }

  .content-slide-modal-body {
    max-width: 75%;
    margin: 0 auto;
    margin-top: 24px;
    border-radius: 0;
    box-shadow: none;
    width: 75%;
    @media screen and (max-width: 1024px) {
      margin: 24px 48px;
      max-width: initial;
      width: auto;
    }
  }

  .content-slide-thumbnails {
    @media screen and (max-width: 640px) {
      position: absolute;
      bottom: 0;
    }
  }

  .content-slider-modal-header {
    border: none;
    border-bottom: 2px solid rgb(217 220 224);
    text-align: center;
    padding: 18px 0;

    @media screen and (min-width: 1025px) {
      width: 75%;
      max-width: 75%;
      box-shadow: none;
      margin: auto;
      position: relative;
      text-align: left; 
    }

    @media screen and (max-width: 1024px) {
      margin: 24px 48px;
    }
    
    @media screen and (max-width: 640px) {
      padding: 18px 40px; 
      margin: 0;
    }
  }

  .splide__slide.content-in-modal-slide {
    img {
      max-height: 700px;
      max-width: 700px;
    }
  }
