',\n      H + \'[class*="productTwoColumnInfoContainer"] [class*="directBanner"],\',\n      H + \'[class*="productTwoColumnInfoContainer"] [class*="productBadgeContainer"] { visibility:hidden !important; }\',\n\n      /* ================= PLP / SRP \u2014 ALL WIDTHS ================= */\n      /* badges are vertically-stacked direct children of productImg at every breakpoint */\n      PLP + \' { display:flex !important; flex-direction:column !important; }\',\n      PLP + \' > * { flex-shrink:0 !important; }\',\n      PLP + \' > [class*="belowImageBadge"] { order:0 !important; }\',\n      PLP + \' > :not([class*="belowImageBadge"]):not([class*="directBanner"]) { order:1 !important; }\',\n      PLP + \' > [class*="directBanner"] { order:2 !important; }\',\n\n      /* ================= PDP \u2014 DESKTOP (>=768px) ================= */\n      \'@media (min-width:768px){\',\n      PDP + \' { display:flex !important; flex-direction:column !important; }\',\n      PDP + \' > * { flex-shrink:0 !important; }\',\n      PDP + \' > [class*="hideMobile"]:has([class*="productBadge"]) { order:0 !important; }\',\n      PDP + \' > h1 { order:1 !important; }\',\n      PDP + \' > div:has(> a[class*="odtLink"]) { order:2 !important; }\',\n      PDP + \' > [class*="productSubTitle"] { order:3 !important; }\',\n      PDP + \' > [class*="directBanner"] { order:4 !important; }\',\n      PDP + \' > :not([class*="hideMobile"]:has([class*="productBadge"])):not(h1):not([class*="productSubTitle"]):not([class*="directBanner"]):not(:has(> a[class*="odtLink"])) { order:5 !important; }\',\n      \'}\',\n\n      /* ================= PDP \u2014 MOBILE (<768px) ================= */\n      /* lower badge is nested in showMobile WITH the image; mobile-appropriate swap:\n         upper -> below the image block; lower -> above the image (inside showMobile) */\n      \'@media (max-width:767.98px){\',\n      PDPm + \' { display:flex !important; flex-direction:column !important; }\',\n      PDPm + \' > * { flex-shrink:0 !important; }\',\n      PDPm + \' > h1 { order:1 !important; }\',\n      PDPm + \' > div:has(> a[class*="odtLink"]) { order:2 !important; }\',\n      PDPm + \' > [class*="productSubTitle"] { order:3 !important; }\',\n      PDPm + \' > [class*="showMobile"] { order:4 !important; display:flex !important; flex-direction:column !important; }\',\n      PDPm + \' > [class*="directBanner"] { order:5 !important; }\',\n      PDPm + \' > :not(h1):not([class*="productSubTitle"]):not([class*="showMobile"]):not([class*="directBanner"]):not(:has(> a[class*="odtLink"])) { order:6 !important; }\',\n      /* inside showMobile: lower badge above the image */\n      PDPm + \' > [class*="showMobile"] > [class*="productBadgeContainer"] { order:0 !important; }\',\n      PDPm + \' > [class*="showMobile"] > :not([class*="productBadgeContainer"]) { order:1 !important; }\',\n      \'}\'\n    ].join(\'\\n\');\n\n    var st = document.createElement(\'style\');\n    st.id = STYLE_ID;\n    st.textContent = css;\n    (document.head || html).appendChild(st);\n  }\n\n  if (sessionStorage.getItem(FLAG_KEY) !== VARIANT) {\n    html.classList.remove(ACTIVE);\n    html.classList.remove(READY);\n    return;\n  }\n  html.classList.add(ACTIVE);\n  setTimeout(function () { html.classList.add(READY); }, REVEAL_MS);\n})();',language:"javascript"}}]},{id:"RL952178b796324e46903bd2a6edc0a86f",name:"Pixel Event Forwarding | page view - Logged In - send WEB SDK event | RTR - Retry Trigger (Cookie Detected)",events:[{modulePath:"core/src/lib/events/customCode.js",settings:{source:function(){if(!sessionStorage.getItem("rtrInitialFired")&&!sessionStorage.getItem("rtrDelayedFired")){const e=20;let t=0;const a=setInterval((function(){document.cookie.includes("DotomiUser")?(clearInterval(a),sessionStorage.setItem("rtrDelayedFired","true"),_satellite.track("rtrDelayedTrigger"),console.log("\u2705 RTR Delayed Trigger Fired (Dotomi cookie detected, initial did not fire)")):(t++,t>=e&&(clearInterval(a),console.