actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"(function () {\n  const KEY = 'AT-WDModalV3';\n  const EXPIRATION_HOURS = 12;\n\n  const raw = localStorage.getItem(KEY);\n  if (!raw) return;\n\n  try {\n    const parsed = JSON.parse(raw);\n    if (!parsed.time) {\n      localStorage.removeItem(KEY);\n      return;\n    }\n\n    const storedTime = parsed.time;\n    const diffHours = (Date.now() - storedTime) / 36e5;\n\n    if (diffHours >= EXPIRATION_HOURS) {\n      localStorage.removeItem(KEY);\n    }\n  } catch (e) {\n    localStorage.removeItem(KEY);\n  }\n})();",language:"javascript"}},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"/*\n(function () {\n  const KEY = 'AT-WDModalV3';\n  const EXPIRATION_MINUTES = 10;\n\n  const raw = localStorage.getItem(KEY);\n  if (!raw) return;\n\n  try {\n    const parsed = JSON.parse(raw);\n    if (!parsed.time) {\n      localStorage.removeItem(KEY);\n      return;\n    }\n\n    const storedTime = parsed.time;\n\n    // Convert milliseconds difference into minutes\n    const diffMinutes = (Date.now() - storedTime) / (1000 * 60);\n\n    if (diffMinutes >= EXPIRATION_MINUTES) {\n      localStorage.removeItem(KEY);\n    }\n  } catch (e) {\n    localStorage.removeItem(KEY);\n  }\n})();\n*/",language:"javascript"}}]},{id:"RLc9717af1e02f4bad84204dbc0a1f99d0",name:"Adobe Target | Remove C3 Phone Number from Contact Us page",events:[{modulePath:"core/src/lib/events/customCode.js",settings:{source:function(e){"experiment"==sessionStorage.getItem("AT-ContactUsPageShowHide")&&e()}},ruleOrder:50},{modulePath:"core/src/lib/events/directCall.js",settings:{identifier:"AT-ContactUsPageShowHide"},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/customer-service/contact-us",valueIsRegex:!0}]}}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/0701d9334ca0/45eff1f577e9/aef53d52e6c6/RCb18dfe0d2019