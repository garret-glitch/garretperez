generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  username      String      @unique
  passwordHash  String
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  accounts      Account[]
  sessions      Session[]
  skills        UserSkill[]
  posts         Post[]
  recipes       Recipe[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SkillType {
  HEALTH
  PROJECTS
  FISHING
  BUSINESS
  FOOD
  COMMUNITY
  GARDENING
  FUN
  TRAVEL
}

model UserSkill {
  id     String    @id @default(cuid())
  userId String
  skill  SkillType
  xp     Int       @default(0)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

model Post {
  id        String    @id @default(cuid())
  userId    String
  skill     SkillType
  title     String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String
  ingredients  String   @db.Text
  instructions String   @db.Text
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
