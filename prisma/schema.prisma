generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  username      String         @unique
  passwordHash  String
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  role          UserRole       @default(USER)
  banned        Boolean        @default(false)
  accounts      Account[]
  sessions      Session[]
  skills        UserSkill[]
  posts         Post[]
  recipes       Recipe[]
  replies       PostReply[]
  badges        UserBadge[]
  upvotes       PostUpvote[]
  skillVisits   SkillVisit[]
  announcements Announcement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SkillType {
  HEALTH
  PROJECTS
  FISHING
  BUSINESS
  FOOD
  COMMUNITY
  GARDENING
  FUN
  TRAVEL
}

enum BadgeType {
  FOUNDER
  TOP_POSTER
  PROJECT_HELPER
  HALLOWEEN_CREW
  GARDENER
  CRAFTSMAN
  GAME_WINNER
  DAILY_ADVENTURER
  CHEF
  FIRST_POST
}

model UserSkill {
  id     String    @id @default(cuid())
  userId String
  skill  SkillType
  xp     Int       @default(0)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

model Post {
  id        String       @id @default(cuid())
  userId    String
  skill     SkillType
  title     String
  body      String       @db.Text
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   PostReply[]
  upvotes   PostUpvote[]
}

model PostReply {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostUpvote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  badge     BadgeType
  awardedAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
}

model SkillVisit {
  id     String    @id @default(cuid())
  userId String
  skill  SkillType
  date   String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill, date])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

// Key-value store for site-wide settings (e.g. headshot image)
model SiteSetting {
  key   String @id
  value String @db.Text
}

model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String
  ingredients  String   @db.Text
  instructions String   @db.Text
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
