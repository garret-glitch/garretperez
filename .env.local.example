# Copy this file to .env.local and fill in your values

# Get a free PostgreSQL database at neon.tech
# Go to: neon.tech → create project → copy the connection string
DATABASE_URL="postgresql://username:password@hostname/dbname?sslmode=require"

# Generate a random secret: run this in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-random-secret-here"

# Your local dev URL (change to your domain in Vercel dashboard for production)
NEXTAUTH_URL="http://localhost:3000"
